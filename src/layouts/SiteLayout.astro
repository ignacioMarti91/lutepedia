---
import SvgFilters from "../components/SvgFilters.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../../styles.css";

interface Props {
  title: string;
  description: string;
  currentPage?: string;
}

const { title, description, currentPage = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(`${base}${Astro.url.pathname}`, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Lutepedia</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Lutepedia`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Caveat:wght@500;700&family=Newsreader:ital,wght@0,400;0,600;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <div class="pg">
      <SvgFilters />
      <svg class="grain" aria-hidden="true" focusable="false">
        <rect width="100%" height="100%" filter="url(#grainf)"></rect>
      </svg>
      <SiteHeader currentPage={currentPage} base={base} />
      <main id="main"><slot /></main>
      <SiteFooter base={base} />
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .pg {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #eee4ce;
    color: #1c1b2e;
    font-family: "Newsreader", Georgia, serif;
    font-size: 19px;
    line-height: 1.6;
  }
</style>
