---
import { getCollection } from "astro:content";
import EntryCard from "../../components/EntryCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { newestFirst, postKindLabels, tagSlug } from "../../data/content";

export async function getStaticPaths() {
  const [posts, classes, projects] = await Promise.all([
    getCollection("posts", ({ data }) => !data.draft),
    getCollection("classes", ({ data }) => !data.draft),
    getCollection("projects", ({ data }) => !data.draft),
  ]);
  const entries = [...posts, ...classes, ...projects];
  const tags = new Map<string, string>();
  for (const entry of entries) {
    for (const tag of entry.data.tags) tags.set(tagSlug(tag), tag);
  }

  return [...tags].map(([slug, label]) => ({
    params: { tag: slug },
    props: { entries: entries.filter((entry) => entry.data.tags.some((tag) => tagSlug(tag) === slug)), label },
  }));
}

const { entries, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout title={`Etiqueta: ${label}`} description={`Publicaciones de Lutepedia sobre ${label}.`}>
  <section class="wrap">
    <p class="crumbs"><a href={`${base}/index.html`}>Inicio</a> / Etiquetas / {label}</p>
    <p class="hand kicker">Todo lo que vuelve a este tema</p>
    <h1 class="page-title"><span class="w">#{label}</span></h1>
    <div class="grid">
      {newestFirst(entries.filter((entry) => entry.collection !== "projects")).map((entry) => (
        <EntryCard
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.pubDate}
          tags={entry.data.tags}
          kind={entry.collection === "classes" ? "Ficha de clase" : postKindLabels[entry.data.kind]}
          href={`/${entry.collection === "classes" ? "clases" : "pieza"}/${entry.id}.html`}
        />
      ))}
      {entries.filter((entry) => entry.collection === "projects").map((entry) => (
        <EntryCard
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.pubDate}
          tags={entry.data.tags}
          kind="Producción"
          href={`/casos/${entry.id}.html`}
        />
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .kicker { margin: 0 0 8px; color: #4a4466; font-size: 26px; }
</style>
